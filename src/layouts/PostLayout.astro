---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import "../styles/prose.css";

interface Props {
  title: string;
  description?: string;
  tags?: string[];
  date?: Date;
  difficulty?: string;
  os?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  tags = [],
  date,
  difficulty,
  os,
  headings = [],
} = Astro.props;

const difficultyColors: Record<string, string> = {
  easy: "#2ea043",
  medium: "#d29922",
  hard: "#f85149",
  insane: "#a371f7",
};
---

<BaseLayout {title} {description}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-description">{description}</p>}

      <div class="post-meta">
        {
          date && (
            <span class="meta-item">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              {date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </span>
          )
        }
        {os && <span class="meta-badge">{os}</span>}
        {
          difficulty && (
            <span
              class="meta-badge"
              style={`color: ${difficultyColors[difficulty] ?? "inherit"}; border-color: ${difficultyColors[difficulty] ?? "var(--color-border)"}`}
            >
              {difficulty}
            </span>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )
      }

      <hr class="post-divider" />
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <TableOfContents slot="toc" {headings} />
</BaseLayout>

<style>
  .post {
    max-width: var(--content-max-width);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .post-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .meta-badge {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: var(--color-sidebar-active-bg);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .post-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-top: 1.25rem;
  }

  :global(.lb-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    cursor: zoom-out;
    backdrop-filter: blur(4px);
  }

  :global(.lb-overlay img) {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border: none;
    border-radius: var(--radius-md);
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
    img.style.cursor = "zoom-in";
    img.addEventListener("click", () => {
      const overlay = document.createElement("div");
      overlay.className = "lb-overlay";
      const pic = document.createElement("img");
      pic.src = img.src;
      pic.alt = img.alt;
      overlay.appendChild(pic);
      overlay.addEventListener("click", () => overlay.remove());
      document.addEventListener("keydown", function onKey(e) {
        if (e.key === "Escape") {
          overlay.remove();
          document.removeEventListener("keydown", onKey);
        }
      });
      document.body.appendChild(overlay);
    });
  });
</script>
