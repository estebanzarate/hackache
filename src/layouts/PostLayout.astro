---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import PostActions from "../components/PostActions.astro";
import "../styles/prose.css";

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface NavLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  tags?: string[];
  headings?: MarkdownHeading[];
  breadcrumb?: BreadcrumbItem[];
  prev?: NavLink | null;
  next?: NavLink | null;
  readingTime?: number;
  body?: string;
}

const {
  title,
  description,
  tags = [],
  headings = [],
  breadcrumb = [],
  prev,
  next,
  readingTime,
  body = "",
} = Astro.props;
---

<BaseLayout {title} {description}>
  <article class="post">
    <header class="post-header">
      {
        breadcrumb.length > 0 && (
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/" class="bc-item bc-link">
              Home
            </a>
            {breadcrumb.map((item) => (
              <>
                <span class="bc-sep">/</span>
                {item.href ? (
                  <a href={item.href} class="bc-item bc-link">
                    {item.label}
                  </a>
                ) : (
                  <span class="bc-item bc-label">{item.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }

      <h1 class="post-title">{title}</h1>
      {description && <p class="post-description">{description}</p>}

      <div class="post-meta">
        {
          readingTime && (
            <span class="meta-item">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              {readingTime} min read
            </span>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}`} class="tag">
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <PostActions {title} {body} />

      <hr class="post-divider" />
    </header>

    <div class="prose" data-pagefind-body>
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="post-nav" aria-label="Post navigation">
          <div class="post-nav-grid">
            {prev ? (
              <a href={prev.href} class="post-nav-link post-nav-link--prev">
                <span class="post-nav-dir">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="15 18 9 12 15 6" />
                  </svg>
                  Previous
                </span>
                <span class="post-nav-title">{prev.title}</span>
              </a>
            ) : (
              <div />
            )}
            {next ? (
              <a href={next.href} class="post-nav-link post-nav-link--next">
                <span class="post-nav-dir">
                  Next
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </span>
                <span class="post-nav-title">{next.title}</span>
              </a>
            ) : (
              <div />
            )}
          </div>
        </nav>
      )
    }
  </article>

  <TableOfContents slot="toc" {headings} />
</BaseLayout>

<script>
  const copyIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
  </svg>`;

  const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polyline points="20 6 9 17 4 12"/>
  </svg>`;

  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.setAttribute("aria-label", "Copy code");
    btn.innerHTML = copyIcon;
    wrapper.appendChild(btn);

    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.innerText ?? "";
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      btn.innerHTML = checkIcon;
      btn.classList.add("copied");
      setTimeout(() => {
        btn.innerHTML = copyIcon;
        btn.classList.remove("copied");
      }, 2000);
    });
  });
</script>

<style>
  .post {
    max-width: var(--content-max-width);
  }
  .post-header {
    margin-bottom: 2rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.875rem;
  }

  .bc-item {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .bc-link {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .bc-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .bc-sep {
    font-size: var(--font-size-xs);
    color: var(--color-border);
    font-family: var(--font-mono);
    user-select: none;
  }

  .post-title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .post-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .tag {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: var(--color-sidebar-active-bg);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .tag:hover {
    background: var(--color-bg-hover);
    text-decoration: none;
  }

  .post-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-top: 1.25rem;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .post-nav-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
    text-decoration: none;
  }

  .post-nav-link--next {
    text-align: right;
  }

  .post-nav-dir {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .post-nav-link--next .post-nav-dir {
    justify-content: flex-end;
  }

  .post-nav-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .post-nav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
