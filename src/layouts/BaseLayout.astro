---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchModal from "../components/SearchModal.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  tags?: string[];
  publishedTime?: string;
  noindex?: boolean;
  postLang?: string;
  hasTranslation?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  tags = [],
  publishedTime,
  noindex = false,
  postLang,
  hasTranslation = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = title === "Home" ? "hackache" : `${title} · hackache`;
---

<!doctype html>
<html lang="en" data-lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <SEO
      {title}
      {description}
      {image}
      {canonicalURL}
      {type}
      {tags}
      {publishedTime}
      {noindex}
    />
    <script is:inline define:vars={{ postLang, hasTranslation }}>
      const theme = localStorage.getItem("theme");
      document.documentElement.setAttribute("data-theme", theme || "dark");

      const fontSz = localStorage.getItem("font-size");
      if (fontSz)
        document.documentElement.setAttribute("data-font-size", fontSz);

      let lang = localStorage.getItem("lang") || "en";

      if (
        hasTranslation &&
        postLang &&
        (postLang === "en" || postLang === "es") &&
        lang !== postLang
      ) {
        lang = postLang;
        localStorage.setItem("lang", lang);
      }

      document.documentElement.setAttribute("data-lang", lang);
      document.documentElement.lang = lang;
    </script>
  </head>
  <body>
    <Header />
    <SearchModal />
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <div class="layout">
      <Sidebar />
      <main class="main-content">
        <slot />
      </main>
      <slot name="toc" />
    </div>

    <div id="lb" aria-modal="true" role="dialog" aria-label="Image zoom">
      <button id="lb-close" aria-label="Close zoom">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <img id="lb-img" src="" alt="" />
    </div>

    <script>
      const lb = document.getElementById("lb")!;
      const lbImg = document.getElementById("lb-img") as HTMLImageElement;
      const lbClose = document.getElementById("lb-close")!;

      const open = (src: string, alt: string) => {
        lbImg.src = src;
        lbImg.alt = alt;
        lb.classList.add("lb--open");
        document.body.style.overflow = "hidden";
      };

      const close = () => {
        lb.classList.remove("lb--open");
        document.body.style.overflow = "";
        setTimeout(() => {
          lbImg.src = "";
        }, 250);
      };

      const applyLightbox = () => {
        document
          .querySelectorAll<HTMLImageElement>(
            "img:not(#lb-img):not([data-no-zoom])",
          )
          .forEach((img) => {
            if (
              img.closest("#lb") ||
              img.closest(".sidebar") ||
              img.closest(".header")
            )
              return;
            if (!img.src || img.getAttribute("data-lb-init")) return;
            img.setAttribute("data-lb-init", "1");
            img.style.cursor = "zoom-in";
            img.addEventListener("click", () => open(img.src, img.alt));
          });
      };

      lb.addEventListener("click", (e) => {
        if (e.target === lb) close();
      });
      lbClose.addEventListener("click", close);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });

      applyLightbox();
    </script>

    <style>
      #lb {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        backdrop-filter: blur(4px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity 220ms ease,
          visibility 220ms ease;
      }

      #lb.lb--open {
        opacity: 1;
        visibility: visible;
        pointer-events: all;
      }

      #lb-img {
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: var(--radius-md);
        border: none;
        margin: 0;
        box-shadow: 0 0 80px rgba(0, 0, 0, 0.8);
        cursor: zoom-out;
      }

      #lb-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: var(--radius-md);
        cursor: pointer;
        color: #fff;
        padding: 0.4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background var(--transition-fast);
      }

      #lb-close:hover {
        background: rgba(255, 255, 255, 0.2);
      }
    </style>

    <style>
      .layout {
        display: flex;
        align-items: flex-start;
      }

      .main-content {
        flex: 1;
        margin-left: var(--sidebar-width);
        min-height: calc(100vh - var(--header-height));
        padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
        min-width: 0;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 44;
        backdrop-filter: blur(2px);
      }

      .sidebar-backdrop.open {
        display: block;
      }

      @media (min-width: 769px) {
        .sidebar-backdrop {
          display: none !important;
        }
      }

      @media (max-width: 768px) {
        .main-content {
          margin-left: 0;
          padding: 1.5rem 1rem;
        }
      }
    </style>
  </body>
</html>
