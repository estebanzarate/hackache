---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import SearchModal from "../components/SearchModal.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  tags?: string[];
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = "website",
  tags = [],
  publishedTime,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = title === "Home" ? "hackache" : `${title} · hackache`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <SEO
      {title}
      {description}
      {image}
      {canonicalURL}
      {type}
      {tags}
      {publishedTime}
      {noindex}
    />
    <script is:inline>
      const saved = localStorage.getItem("theme");
      document.documentElement.setAttribute("data-theme", saved || "dark");
      const savedFont = localStorage.getItem("font-size");
      if (savedFont)
        document.documentElement.setAttribute("data-font-size", savedFont);
    </script>
  </head>
  <body>
    <Header />
    <SearchModal />
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <div class="layout">
      <Sidebar />
      <main class="main-content">
        <slot />
      </main>
      <slot name="toc" />
    </div>

    <style>
      .layout {
        display: flex;
        align-items: flex-start;
      }

      .main-content {
        flex: 1;
        margin-left: var(--sidebar-width);
        min-height: calc(100vh - var(--header-height));
        padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
        min-width: 0;
        overflow-x: hidden;
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 44;
        backdrop-filter: blur(2px);
      }

      .sidebar-backdrop.open {
        display: block;
      }

      @media (min-width: 769px) {
        .sidebar-backdrop {
          display: none !important;
        }
      }

      @media (max-width: 768px) {
        .main-content {
          margin-left: 0;
        }
      }
    </style>
  </body>
</html>
