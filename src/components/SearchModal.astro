<div class="search-backdrop" id="search-backdrop" aria-hidden="true">
  <div class="search-box" role="dialog" aria-modal="true">
    <div class="s-header">
      <svg
        class="s-icon"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        id="search-input"
        class="s-input"
        type="text"
        placeholder="Search..."
        data-i18n="search.placeholder"
        autocomplete="off"
        spellcheck="false"
      />
      <button id="search-close" class="s-close" aria-label="Close">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="search-results" class="s-body">
      <p class="s-hint">Type to search...</p>
    </div>
  </div>
</div>

<script>
  import Fuse, { type FuseResult } from "fuse.js";
  import { ui } from "../i18n/translations";
  import type { Lang } from "../i18n/translations";

  let currentLang = (localStorage.getItem("lang") ?? "en") as Lang;
  const t = () => ui[currentLang];

  interface SearchItem {
    title: string;
    description: string;
    url: string;
    tags: string[];
    section: string;
    category: string;
    content: string;
    difficulty?: string;
    os?: string;
  }

  const backdrop = document.getElementById("search-backdrop") as HTMLElement;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const body = document.getElementById("search-results") as HTMLElement;
  const closeBtn = document.getElementById("search-close") as HTMLButtonElement;

  let fuse: Fuse<SearchItem> | null = null;
  let selectedIndex = -1;
  let debounce: ReturnType<typeof setTimeout>;

  const catLabels: Record<string, string> = {
    linux: "Linux",
    windows: "Windows",
    htb: "Hack The Box",
    thm: "Try Hack Me",
    "docker-labs": "Docker Labs",
    vulnyx: "Vulnyx",
    "the-hackers-labs": "The Hackers Labs",
    "pico-ctf": "PicoCTF",
  };

  const fmtCat = (c: string) =>
    catLabels[c] ?? c.charAt(0).toUpperCase() + c.slice(1).replace(/-/g, " ");

  const diffColors: Record<string, string> = {
    easy: "#2ea043",
    medium: "#d29922",
    hard: "#f85149",
    insane: "#a371f7",
  };

  const open = () => {
    backdrop.setAttribute("aria-hidden", "false");
    backdrop.classList.add("open");
    document.body.style.overflow = "hidden";
    selectedIndex = -1;
    setTimeout(() => input.focus(), 50);
  };

  const close = () => {
    backdrop.setAttribute("aria-hidden", "true");
    backdrop.classList.remove("open");
    document.body.style.overflow = "";
    input.value = "";
    showHint();
  };

  const showHint = () => {
    body.innerHTML = `<p class="s-hint">${t()["search.hint"]}</p>`;
    selectedIndex = -1;
  };

  const showEmpty = (q: string) => {
    body.innerHTML = `<p class="s-hint">${t()["search.noResults.prefix"]} <strong>${esc(q)}</strong></p>`;
  };

  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  const mark = (text: string, q: string): string => {
    if (!q || !text) return esc(text);
    const pattern = q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return esc(text).replace(
      new RegExp(`(${pattern})`, "gi"),
      "<mark>$1</mark>",
    );
  };

  const getExcerpt = (content: string, q: string, len = 130): string => {
    if (!content) return "";
    const idx = content.toLowerCase().indexOf(q.toLowerCase());
    const start = idx === -1 ? 0 : Math.max(0, idx - 50);
    const end = Math.min(content.length, start + len);
    const snippet = content.slice(start, end);
    return (
      (start > 0 ? "…" : "") +
      mark(snippet, q) +
      (end < content.length ? "…" : "")
    );
  };

  const renderResults = (hits: FuseResult<SearchItem>[], q: string) => {
    if (!hits.length) {
      showEmpty(q);
      return;
    }

    body.innerHTML = hits
      .slice(0, 8)
      .map((r, i) => {
        const it = r.item;
        const excerpt = it.description
          ? mark(it.description, q)
          : getExcerpt(it.content, q);
        const diff = it.difficulty
          ? `<span class="r-diff" style="color:${diffColors[it.difficulty] ?? "inherit"}">${it.difficulty}</span>`
          : "";

        return `
        <a href="${it.url}" class="r-item" tabindex="0" data-index="${i}">
          <div class="r-path">
            <span class="r-dot r-dot--${it.section}"></span>
            <span>${it.section} · ${fmtCat(it.category)}</span>
          </div>
          <div class="r-title-row">
            <span class="r-title">${mark(it.title, q)}</span>
            ${diff}
          </div>
          ${excerpt ? `<p class="r-excerpt">${excerpt}</p>` : ""}
        </a>`;
      })
      .join("");

    selectedIndex = -1;
  };

  const loadIndex = async (): Promise<boolean> => {
    if (fuse) return true;
    try {
      const res = await fetch("/search-index.json");
      if (!res.ok) throw new Error();
      const data: SearchItem[] = await res.json();
      fuse = new Fuse(data, {
        keys: [
          { name: "title", weight: 0.5 },
          { name: "description", weight: 0.2 },
          { name: "tags", weight: 0.2 },
          { name: "content", weight: 0.1 },
        ],
        threshold: 0.35,
        includeScore: true,
        minMatchCharLength: 2,
      });
      return true;
    } catch {
      return false;
    }
  };

  const runSearch = async () => {
    const q = input.value.trim();
    if (!q) {
      showHint();
      return;
    }
    const ok = await loadIndex();
    if (!ok) {
      body.innerHTML = '<p class="s-hint">Index not available.</p>';
      return;
    }
    renderResults(fuse!.search(q), q);
  };

  const getItems = () => body.querySelectorAll<HTMLAnchorElement>(".r-item");

  const selectItem = (idx: number) => {
    const items = getItems();
    selectedIndex = Math.max(-1, Math.min(idx, items.length - 1));
    items.forEach((el, i) =>
      el.classList.toggle("selected", i === selectedIndex),
    );
    if (selectedIndex === -1) input.focus();
    else items[selectedIndex]?.focus();
  };

  input.addEventListener("input", () => {
    if (!input.value.trim()) {
      clearTimeout(debounce);
      showHint();
      return;
    }
    clearTimeout(debounce);
    debounce = setTimeout(runSearch, 200);
  });

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      selectItem(0);
    }
    if (e.key === "Escape") close();
  });

  body.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      selectItem(selectedIndex + 1);
    }
    if (e.key === "ArrowUp") {
      e.preventDefault();
      if (selectedIndex <= 0) {
        selectedIndex = -1;
        input.focus();
      } else selectItem(selectedIndex - 1);
    }
    if (e.key === "Escape") close();
  });

  body.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest(".r-item")) close();
  });

  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) close();
  });
  closeBtn.addEventListener("click", close);
  document.addEventListener("search:open", open);

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      backdrop.classList.contains("open") ? close() : open();
    }
    if (e.key === "Escape" && backdrop.classList.contains("open")) close();
  });

  document.addEventListener("lang:change", ((e: CustomEvent) => {
    currentLang = e.detail.lang;
    if (!backdrop.classList.contains("open")) return;
    if (!input.value.trim()) showHint();
  }) as EventListener);
</script>

<style>
  .search-backdrop {
    display: flex;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    z-index: 100;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 180ms ease,
      background 180ms ease;
  }

  .search-backdrop.open {
    background: rgba(0, 0, 0, 0.55);
    opacity: 1;
    pointer-events: all;
    backdrop-filter: blur(3px);
  }

  .search-box {
    width: 100%;
    max-width: 580px;
    margin: 0 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    transform: translateY(-8px);
    opacity: 0;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .search-backdrop.open .search-box {
    transform: translateY(0);
    opacity: 1;
  }

  .s-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .s-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .s-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: var(--font-size-base);
    font-family: var(--font-sans);
    color: var(--color-text);
    min-width: 0;
  }

  .s-input::placeholder {
    color: var(--color-text-muted);
  }

  .s-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .s-close:hover {
    color: var(--color-text);
    background: var(--color-bg-hover);
  }

  .s-body {
    max-height: 420px;
    overflow-y: auto;
  }

  :global(.s-hint) {
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  :global(.s-hint strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  :global(.r-item) {
    display: block;
    padding: 0.875rem 1.25rem 0.875rem 1.125rem;
    border-left: 2px solid transparent;
    text-decoration: none;
    outline: none;
    cursor: pointer;
    transition:
      background var(--transition-fast),
      border-left-color var(--transition-fast);
  }

  :global(.r-item + .r-item) {
    border-top: 1px solid var(--color-border);
  }

  :global(.r-item:hover),
  :global(.r-item:focus),
  :global(.r-item.selected) {
    background: var(--color-bg-secondary);
    border-left-color: var(--color-accent);
    text-decoration: none;
  }

  :global(.r-path) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.3rem;
  }

  :global(.r-dot) {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  :global(.r-dot--notes) {
    background-color: var(--color-accent);
  }
  :global(.r-dot--writeups) {
    background-color: #7aa2f7;
  }

  :global(.r-title-row) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }

  :global(.r-title) {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  :global(.r-diff) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  :global(.r-excerpt) {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(mark) {
    background: none;
    color: var(--color-accent);
    font-weight: 700;
    font-style: normal;
  }

  @media (max-width: 480px) {
    .search-backdrop {
      padding-top: 0;
    }
    .search-box {
      margin: 0;
      max-width: 100%;
      border-top: none;
      border-left: none;
      border-right: none;
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }
  }
</style>
