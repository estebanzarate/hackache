---
const writeups = [
  {
    title: 'Lookup',
    platform: 'Try Hack Me',
    difficulty: 'Easy',
    os: 'Linux',
    tags: ['Brute force', 'CVE-2019-9194', 'SUID files', 'Sudoers'],
    slug: '/try-hack-me/machines/lookup',
  },
  {
    title: 'BreakMySSH',
    platform: 'Docker Labs',
    difficulty: 'Muy Fácil',
    os: 'Linux',
    tags: ['SSH'],
    slug: '/docker-labs/machines/overview',
  },
  {
    title: 'Mirage',
    platform: 'Hack The Box',
    difficulty: 'Hard',
    os: 'Windows',
    tags: ['Kerberoasting', 'DCSync', 'ESC10', 'gMSA'],
    slug: '/hack-the-box/machines/overview',
  },
];

const difficultyColor: Record<string, string> = {
  Easy: 'var(--sl-color-accent)',
  Medium: '#f59e0b',
  Hard: '#ef4444',
  Insane: '#a855f7',
  'Muy Fácil': 'var(--sl-color-accent)',
  Fácil: 'var(--sl-color-accent)',
  Difícil: '#ef4444',
  Principiante: 'var(--sl-color-accent)',
  Low: '#f59e0b',
};
---

<section class="recent-writeups">
  <h2>Recent Writeups</h2>
  <div class="writeups-grid">
    {
      writeups.map((w) => (
        <a href={w.slug} class="writeup-card">
          <div class="card-header">
            <span class="platform">{w.platform}</span>
            <span class="os">{w.os}</span>
          </div>
          <h3 class="card-title">{w.title}</h3>
          <span
            class="difficulty"
            style={`color: ${difficultyColor[w.difficulty] ?? '#94a3b8'}`}
          >
            {w.difficulty}
          </span>
          <div class="tags">
            {w.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .recent-writeups {
    margin: 2rem 0;
  }

  .recent-writeups h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-text);
    margin-bottom: 1.25rem;
    border-left: 3px solid var(--sl-color-accent);
    padding-left: 0.75rem;
  }

  .writeups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .writeup-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-5));
    background: var(--sl-color-bg-sidebar);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .writeup-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-text);
    margin: 0;
  }

  .difficulty {
    font-size: 0.8rem;
    font-weight: 500;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-text-accent);
    border: 1px solid var(--sl-color-accent-low);
  }
</style>
