---
import { getCollection } from "astro:content";
import NavTree from "./NavTree.astro";
import type { NavNode } from "./NavTree.astro";

const all = await getCollection("posts", ({ data }) => !data.draft);
const currentPath = Astro.url.pathname;

const getPostLang = (p: (typeof all)[number]): string => p.data.lang;

const buildChildren = (parentId: string): NavNode[] =>
  all
    .filter((p) => p.data.parent === parentId)
    .sort((a, b) => a.data.order - b.data.order)
    .map((p) => ({
      id: p.id,
      href: `/${p.id}`,
      title: p.data.title,
      order: p.data.order,
      postLang: getPostLang(p),
      children: buildChildren(p.id),
    }));

const topLevel = all.filter((p) => !p.data.parent);

const standalone = topLevel
  .filter((p) => !p.data.group)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    id: p.id,
    href: `/${p.id}`,
    title: p.data.title,
    order: p.data.order,
    postLang: getPostLang(p),
    children: buildChildren(p.id),
  }));

interface NavGroup {
  label: string;
  order: number;
  nodes: NavNode[];
}
const groupMap = new Map<string, NavGroup>();
for (const p of topLevel.filter((p) => p.data.group)) {
  const label = p.data.group!;
  if (!groupMap.has(label))
    groupMap.set(label, { label, order: p.data.groupOrder, nodes: [] });
  groupMap.get(label)!.nodes.push({
    id: p.id,
    href: `/${p.id}`,
    title: p.data.title,
    order: p.data.order,
    postLang: getPostLang(p),
    children: buildChildren(p.id),
  });
}
for (const g of groupMap.values()) g.nodes.sort((a, b) => a.order - b.order);
const groups = [...groupMap.values()].sort(
  (a, b) => a.order - b.order || a.label.localeCompare(b.label),
);

const isActive = (href: string) => currentPath === href;
const hasActiveInTree = (nodes: NavNode[]): boolean =>
  nodes.some((n) => currentPath === n.href || hasActiveInTree(n.children));
---

<aside class="sidebar" id="sidebar" data-pagefind-ignore>
  <nav class="nav" aria-label="Site navigation">
    <div class="nav-section">
      <a href="/" class:list={["nav-item", { active: currentPath === "/" }]}>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9,22 9,12 15,12 15,22"></polyline>
        </svg>
        <span data-i18n="nav.home">Home</span>
      </a>
      <a
        href="/writeups"
        class:list={["nav-item", { active: currentPath === "/writeups" }]}
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          ></polygon>
        </svg>
        <span data-i18n="nav.writeups">Writeups</span>
      </a>
      <a
        href="/tags"
        class:list={["nav-item", { active: currentPath.startsWith("/tags") }]}
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"
          ></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        <span data-i18n="nav.tags">Tags</span>
      </a>
    </div>

    {
      standalone.length > 0 && (
        <div class="nav-section">
          <NavTree nodes={standalone} {currentPath} />
        </div>
      )
    }

    {
      groups.map((group) => (
        <div class="nav-section">
          <div
            class="nav-group"
            data-sb-id={`group::${group.label}`}
            data-open={String(hasActiveInTree(group.nodes))}
          >
            <button
              class="nav-group-label"
              type="button"
              aria-expanded={hasActiveInTree(group.nodes) ? "true" : "false"}
            >
              <svg
                class="nav-chevron"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
              {group.label}
            </button>
            <div class="nav-group-body">
              <div class="nav-group-body-inner">
                <NavTree nodes={group.nodes} {currentPath} />
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </nav>
</aside>

<script>
  const filterByLang = () => {
    const lang = document.documentElement.getAttribute("data-lang") || "en";
    document.querySelectorAll<HTMLElement>("[data-post-lang]").forEach((el) => {
      const itemLang = el.getAttribute("data-post-lang");
      if (!itemLang) return;
      el.style.display = itemLang === lang ? "" : "none";
    });
  };

  filterByLang();

  const KEY = "sb-open";

  const loadOpen = (): string[] => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) ?? "[]");
    } catch {
      return [];
    }
  };

  const saveOpen = () => {
    const open: string[] = [];
    document
      .querySelectorAll<HTMLElement>(".nav-group[data-sb-id]")
      .forEach((el) => {
        if (el.getAttribute("data-open") === "true")
          open.push(el.getAttribute("data-sb-id")!);
      });
    document
      .querySelectorAll<HTMLElement>(".nt-set[data-sb-id]")
      .forEach((el) => {
        if (el.getAttribute("data-open") === "true")
          open.push(el.getAttribute("data-sb-id")!);
      });
    try {
      sessionStorage.setItem(KEY, JSON.stringify(open));
    } catch {}
  };

  const restoreOpen = () => {
    const open = loadOpen();
    document
      .querySelectorAll<HTMLElement>(".nav-group[data-sb-id]")
      .forEach((el) => {
        if (open.includes(el.getAttribute("data-sb-id")!)) {
          el.setAttribute("data-open", "true");
          el.querySelector<HTMLButtonElement>(".nav-group-label")?.setAttribute(
            "aria-expanded",
            "true",
          );
        }
      });
    document
      .querySelectorAll<HTMLElement>(".nt-set[data-sb-id]")
      .forEach((el) => {
        if (open.includes(el.getAttribute("data-sb-id")!))
          el.setAttribute("data-open", "true");
      });
  };

  restoreOpen();

  document
    .querySelectorAll<HTMLButtonElement>(".nav-group-label")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const group = btn.closest<HTMLElement>(".nav-group");
        if (!group) return;
        const isOpen = group.getAttribute("data-open") === "true";
        group.setAttribute("data-open", String(!isOpen));
        btn.setAttribute("aria-expanded", String(!isOpen));
        saveOpen();
      });
    });

  document.querySelectorAll<HTMLButtonElement>(".nt-toggle").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const set = btn.closest<HTMLElement>(".nt-set");
      if (!set) return;
      set.setAttribute(
        "data-open",
        String(set.getAttribute("data-open") !== "true"),
      );
      saveOpen();
    });
  });

  document.querySelectorAll<HTMLElement>(".nt-row").forEach((row) => {
    row.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest(".nt-toggle")) return;
      const set = row.closest<HTMLElement>(".nt-set");
      if (!set) return;
      set.setAttribute(
        "data-open",
        String(set.getAttribute("data-open") !== "true"),
      );
      saveOpen();
    });
  });
</script>

<style>
  .sidebar {
    position: fixed;
    top: var(--header-height);
    left: 0;
    width: var(--sidebar-width);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    background: var(--color-bg-sidebar);
    border-right: 1px solid var(--color-border);
    padding: 1rem 0;
    z-index: 40;
    transition: transform var(--transition);
  }

  .nav {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .nav-section {
    padding: 0.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
  }

  .nav-group-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    transition: background var(--transition-fast);
  }

  .nav-group-label:hover {
    background: var(--color-bg-hover);
  }

  .nav-chevron {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 200ms ease;
  }

  .nav-group[data-open="true"] > .nav-group-label .nav-chevron {
    transform: rotate(90deg);
  }

  .nav-group-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease;
    overflow: hidden;
  }

  .nav-group[data-open="true"] > .nav-group-body {
    grid-template-rows: 1fr;
  }

  .nav-group-body-inner {
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.125rem;
    padding-left: 0.25rem;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
      z-index: 45;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
    }
    :global(.sidebar.open) {
      transform: translateX(0);
    }
  }
</style>
