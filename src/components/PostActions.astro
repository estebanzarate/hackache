---
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---

<div class="post-actions">
  <div class="pa-group" id="share-group">
    <button
      class="pa-btn"
      id="share-btn"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
      </svg>
      <span data-i18n="post.share">Share</span>
    </button>

    <div class="pa-dropdown" id="share-dropdown">
      <a
        id="sl-linkedin"
        class="pa-item"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <span class="pa-dot" style="background:#0a66c2"></span>LinkedIn
      </a>
      <a
        id="sl-twitter"
        class="pa-item"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <span class="pa-dot" style="background:#000000"></span>Twitter / X
      </a>
      <a
        id="sl-facebook"
        class="pa-item"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <span class="pa-dot" style="background:#1877f2"></span>Facebook
      </a>
      <a
        id="sl-telegram"
        class="pa-item"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <span class="pa-dot" style="background:#0088cc"></span>Telegram
      </a>
      <a
        id="sl-whatsapp"
        class="pa-item"
        href="#"
        target="_blank"
        rel="noopener"
      >
        <span class="pa-dot" style="background:#25d366"></span>WhatsApp
      </a>
      <hr class="pa-sep" />
      <button id="sl-copylink" class="pa-item">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
          ></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
          ></path>
        </svg>
        <span id="sl-copylink-label" data-i18n="post.copyLink">Copy link</span>
      </button>
    </div>
  </div>

  <button
    class="pa-btn"
    id="pa-copymd"
    title="Copy raw Markdown — useful for AI prompts"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <polyline points="16 18 22 12 16 6"></polyline>
      <polyline points="8 6 2 12 8 18"></polyline>
    </svg>
    <span id="pa-copymd-label" data-i18n="post.copyMd">Copy MD</span>
  </button>

  <button class="pa-btn" id="pa-pdf" title="Save as PDF">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
      ></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="12" y1="18" x2="12" y2="12"></line>
      <line x1="9" y1="15" x2="15" y2="15"></line>
    </svg>
    <span data-i18n="post.pdf">PDF</span>
  </button>
</div>

<script define:vars={{ title, body }}>
  const url = window.location.href;
  const e = encodeURIComponent;

  const shareMap = {
    "sl-linkedin": `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}`,
    "sl-twitter": `https://twitter.com/intent/tweet?url=${e(url)}&text=${e(title)}`,
    "sl-facebook": `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`,
    "sl-telegram": `https://t.me/share/url?url=${e(url)}&text=${e(title)}`,
    "sl-whatsapp": `https://api.whatsapp.com/send?text=${e(title + " " + url)}`,
  };

  Object.entries(shareMap).forEach(([id, href]) => {
    document.getElementById(id)?.setAttribute("href", href);
  });

  const shareBtn = document.getElementById("share-btn");
  const dropdown = document.getElementById("share-dropdown");
  const shareGroup = document.getElementById("share-group");

  shareBtn?.addEventListener("click", (ev) => {
    ev.stopPropagation();
    const isOpen = dropdown?.classList.contains("open");
    dropdown?.classList.toggle("open", !isOpen);
    shareBtn.setAttribute("aria-expanded", String(!isOpen));
  });

  document.addEventListener("click", (ev) => {
    if (!shareGroup?.contains(ev.target)) {
      dropdown?.classList.remove("open");
      shareBtn?.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("keydown", (ev) => {
    if (ev.key === "Escape") {
      dropdown?.classList.remove("open");
      shareBtn?.setAttribute("aria-expanded", "false");
    }
  });

  const copyToClipboard = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      ta.remove();
    }
  };

  const flashLabel = (id, msg, original, ms = 2000) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    setTimeout(() => {
      el.textContent = original;
    }, ms);
  };

  document
    .getElementById("sl-copylink")
    ?.addEventListener("click", async () => {
      await copyToClipboard(url);
      flashLabel("sl-copylink-label", "Copied!", "Copy link");
      dropdown?.classList.remove("open");
    });

  document.getElementById("pa-copymd")?.addEventListener("click", async () => {
    await copyToClipboard(body);
    flashLabel("pa-copymd-label", "Copied!", "Copy MD");
  });

  document.getElementById("pa-pdf")?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .post-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .pa-group {
    position: relative;
  }

  .pa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-xs);
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .pa-btn:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background: var(--color-bg-hover);
  }

  .pa-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    min-width: 180px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    z-index: 60;
    padding: 0.35rem;
    flex-direction: column;
  }

  .pa-dropdown.open {
    display: flex;
  }

  .pa-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.625rem;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    border: none;
    background: none;
    font-family: var(--font-sans);
    width: 100%;
    text-align: left;
    transition: background var(--transition-fast);
  }

  .pa-item:hover {
    background: var(--color-bg-hover);
    text-decoration: none;
  }

  .pa-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .pa-sep {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0.25rem 0;
  }
</style>
