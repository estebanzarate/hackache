---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const writeups = allPosts
  .filter(
    (p) =>
      !p.data.draft &&
      (p.data.difficulty !== undefined || p.data.platform !== undefined),
  )
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Writeups">
  <div class="wl-page">
    <header class="wl-header">
      <h1 class="wl-title" data-i18n="writeups.title">Writeups</h1>
      <span class="wl-total" id="wl-count">{writeups.length} writeups</span>
    </header>

    <div class="wl-filters">
      <div class="filter-row">
        <span class="filter-label" data-i18n="writeups.difficulty"
          >Difficulty</span
        >
        <div class="filter-group">
          <button class="fbtn fbtn--active" data-fd="all" data-i18n="filter.all"
            >All</button
          >
          <button class="fbtn" data-fd="easy" style="--fc:#9fef00">Easy</button>
          <button class="fbtn" data-fd="medium" style="--fc:#ffaf00"
            >Medium</button
          >
          <button class="fbtn" data-fd="hard" style="--fc:#ff4444">Hard</button>
          <button class="fbtn" data-fd="insane" style="--fc:#ff00ff"
            >Insane</button
          >
        </div>
      </div>
      <div class="filter-row">
        <span class="filter-label" data-i18n="writeups.os">OS</span>
        <div class="filter-group">
          <button class="fbtn fbtn--active" data-fo="all" data-i18n="filter.all"
            >All</button
          >
          <button class="fbtn" data-fo="linux">Linux</button>
          <button class="fbtn" data-fo="windows">Windows</button>
          <button class="fbtn" data-fo="other">Other</button>
        </div>
      </div>
    </div>

    <div class="wl-grid" id="wl-grid">
      {
        writeups.map((post) => (
          <div
            class="wcard-wrap"
            data-fd={post.data.difficulty ?? ""}
            data-fo={post.data.os ?? ""}
          >
            <PostCard {post} />
          </div>
        ))
      }
    </div>

    <p class="wl-empty" id="wl-empty">
      No writeups match the selected filters.
    </p>
  </div>
</BaseLayout>

<script>
  let activeDiff = "all";
  let activeOS = "all";

  const runFilter = () => {
    const cards = document.querySelectorAll<HTMLElement>(".wcard-wrap");
    let visible = 0;

    cards.forEach((card) => {
      const diff = card.getAttribute("data-fd") ?? "";
      const os = card.getAttribute("data-fo") ?? "";
      const show =
        (activeDiff === "all" || diff === activeDiff) &&
        (activeOS === "all" || os === activeOS);
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    const empty = document.getElementById("wl-empty");
    const count = document.getElementById("wl-count");
    if (empty) empty.style.display = visible === 0 ? "block" : "none";
    if (count)
      count.textContent = `${visible} writeup${visible === 1 ? "" : "s"}`;
  };

  document.querySelectorAll<HTMLButtonElement>("[data-fd]").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeDiff = btn.getAttribute("data-fd") ?? "all";
      document
        .querySelectorAll("[data-fd]")
        .forEach((b) => b.classList.toggle("fbtn--active", b === btn));
      runFilter();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-fo]").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeOS = btn.getAttribute("data-fo") ?? "all";
      document
        .querySelectorAll("[data-fo]")
        .forEach((b) => b.classList.toggle("fbtn--active", b === btn));
      runFilter();
    });
  });
</script>

<style>
  .wl-page {
    width: 100%;
    max-width: var(--content-max-width);
  }

  .wl-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.5rem 0 1.25rem;
  }

  .wl-title {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .wl-total {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .wl-filters {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: 2rem;
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    min-width: 60px;
    flex-shrink: 0;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .fbtn {
    padding: 0.25rem 0.75rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-xs);
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .fbtn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .fbtn--active {
    border-color: var(--fc, var(--color-accent));
    color: var(--fc, var(--color-accent));
    background: color-mix(
      in srgb,
      var(--fc, var(--color-accent)) 12%,
      transparent
    );
  }

  .wl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    justify-items: center;
    justify-content: center;
    width: 100%;
  }

  .wl-empty {
    display: none;
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
