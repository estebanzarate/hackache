---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const recent = allPosts
	.filter((p) => !p.data.parent)
	.sort((a, b) => {
		const da = a.data.date ? new Date(a.data.date).getTime() : 0;
		const db = b.data.date ? new Date(b.data.date).getTime() : 0;
		return db - da;
	})
	.slice(0, 6);
---

<BaseLayout title="Home">
	<div class="home" data-pagefind-ignore>
		<section class="hero">
			<h1 class="hero-title">
				<span class="bracket">[</span>hackache<span class="bracket">]</span>
			</h1>
			<p class="hero-sub">hacking notes, writeups & headaches</p>
			<div class="hero-links">
				<a
					href="https://www.linkedin.com/in/esteban-zarate/"
					target="_blank"
					rel="noopener"
					class="hero-link">LinkedIn</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://github.com/estebanzarate"
					target="_blank"
					rel="noopener"
					class="hero-link">GitHub</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://app.hackthebox.com/profile/1089152"
					target="_blank"
					rel="noopener"
					class="hero-link">HackTheBox</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://tryhackme.com/p/nofunny"
					target="_blank"
					rel="noopener"
					class="hero-link">TryHackMe</a
				>
			</div>
		</section>

		{
			recent.length > 0 && (
				<>
					<hr class="section-divider" />
					<section class="section">
						<div class="section-header">
							<h2 class="section-title">Recent Posts</h2>
							<span class="section-count">
								{allPosts.filter((p) => !p.data.parent).length} total
							</span>
						</div>
						<div class="card-grid">
							{recent.map((entry) => (
								<a href={`/${entry.id}`} class="card">
									<div class="card-top">
										<span class="card-title">{entry.data.title}</span>
										{entry.data.group && (
											<span class="card-group">{entry.data.group}</span>
										)}
									</div>
									{entry.data.description && (
										<p class="card-desc">{entry.data.description}</p>
									)}
									<div class="card-bottom">
										<div class="card-tags">
											{entry.data.tags.slice(0, 3).map((tag) => (
												<span class="card-tag">#{tag}</span>
											))}
										</div>
										{entry.data.date && (
											<span class="card-date">
												{new Date(entry.data.date).toLocaleDateString("en-US", {
													month: "short",
													day: "numeric",
													year: "numeric",
												})}
											</span>
										)}
									</div>
								</a>
							))}
						</div>
					</section>
				</>
			)
		}
	</div>
</BaseLayout>

<style>
	.home {
		max-width: var(--content-max-width);
	}

	.hero {
		padding: 1.5rem 0 2rem;
	}

	.hero-title {
		font-size: 2.5rem;
		font-weight: 800;
		font-family: var(--font-mono);
		letter-spacing: -0.03em;
		margin-bottom: 0.5rem;
	}

	.bracket {
		color: var(--color-accent);
	}

	.hero-sub {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
	}

	.hero-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.hero-link {
		font-size: var(--font-size-sm);
		color: var(--color-accent);
		font-family: var(--font-mono);
		text-decoration: none;
	}

	.hero-link:hover {
		text-decoration: underline;
	}
	.hero-sep {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
	}

	.section-divider {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 2rem 0;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.section-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
	}

	.section-count {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: border-color var(--transition-fast);
	}

	.card:hover {
		border-color: var(--color-accent);
		text-decoration: none;
	}

	.card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.card-title {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
		line-height: 1.3;
	}

	.card-group {
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-family: var(--font-mono);
		color: var(--color-accent);
		background: var(--color-sidebar-active-bg);
		padding: 0.15rem 0.4rem;
		border-radius: var(--radius-sm);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.card-desc {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		line-height: 1.5;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-border);
		margin-top: auto;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.card-tag {
		font-size: var(--font-size-xs);
		font-family: var(--font-mono);
		color: var(--color-accent);
	}

	.card-date {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
