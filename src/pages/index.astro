---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const featured = allPosts
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Home">
  <div class="home" data-pagefind-ignore>
    <section class="hero">
      <h1 class="hero-title">
        <span class="bracket">[</span>hackache<span class="bracket">]</span>
      </h1>
      <p class="hero-sub" data-i18n="home.tagline">
        hacking notes, writeups & headaches
      </p>
      <div class="hero-links">
        <a
          href="https://www.estebanzarate.vercel.app/"
          target="_blank"
          rel="noopener"
          class="hero-link">Portfolio</a
        >
        <span class="hero-sep">#</span>
        <a
          href="https://www.linkedin.com/in/esteban-zarate/"
          target="_blank"
          rel="noopener"
          class="hero-link">LinkedIn</a
        >
        <span class="hero-sep">#</span>
        <a
          href="https://github.com/estebanzarate"
          target="_blank"
          rel="noopener"
          class="hero-link">GitHub</a
        >
        <span class="hero-sep">#</span>
        <a
          href="https://app.hackthebox.com/profile/1089152"
          target="_blank"
          rel="noopener"
          class="hero-link">HackTheBox</a
        >
        <span class="hero-sep">#</span>
        <a
          href="https://tryhackme.com/p/nofunny"
          target="_blank"
          rel="noopener"
          class="hero-link">TryHackMe</a
        >
      </div>
    </section>

    {
      featured.length > 0 && (
        <>
          <hr class="section-divider" />
          <div class="card-grid">
            {featured.map((post) => (
              <PostCard {post} />
            ))}
          </div>
        </>
      )
    }

    {
      featured.length === 0 && (
        <p class="empty-hint">
          Add <code>featured: true</code> to any post to show it here.
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  .home {
    width: 100%;
    max-width: var(--content-max-width);
  }

  .hero {
    padding: 1.5rem 0 2rem;
  }

  .hero-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .bracket {
    color: var(--color-accent);
  }

  .hero-sub {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-link {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .hero-link:hover {
    text-decoration: underline;
  }
  .hero-sep {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 2rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .empty-hint {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    padding: 2rem 0;
  }

  .empty-hint code {
    font-family: var(--font-mono);
    background: var(--color-code-bg);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    font-size: 0.9em;
  }
</style>
