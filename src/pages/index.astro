---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allWriteups = await getCollection("writeups", ({ data }) => !data.draft);
const allNotes = await getCollection("notes", ({ data }) => !data.draft);

const recentWriteups = allWriteups
	.sort((a, b) => {
		const da = a.data.date ? new Date(a.data.date).getTime() : 0;
		const db = b.data.date ? new Date(b.data.date).getTime() : 0;
		return db - da;
	})
	.slice(0, 6);

const recentNotes = allNotes
	.sort((a, b) => {
		const da = a.data.date ? new Date(a.data.date).getTime() : 0;
		const db = b.data.date ? new Date(b.data.date).getTime() : 0;
		return db - da;
	})
	.slice(0, 4);

const difficultyColors: Record<string, string> = {
	easy: "#2ea043",
	medium: "#d29922",
	hard: "#f85149",
	insane: "#a371f7",
};
---

<BaseLayout title="Home">
	<div class="home" data-pagefind-ignore>
		<section class="hero">
			<h1 class="hero-title">
				<span class="bracket">[</span>hackache<span class="bracket">]</span>
			</h1>
			<p class="hero-sub">hacking notes, writeups & headaches</p>
			<div class="hero-links">
				<a
					href="https://www.linkedin.com/in/esteban-zarate/"
					target="_blank"
					rel="noopener"
					class="hero-link">LinkedIn</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://github.com/estebanzarate"
					target="_blank"
					rel="noopener"
					class="hero-link">GitHub</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://app.hackthebox.com/profile/1089152"
					target="_blank"
					rel="noopener"
					class="hero-link">HackTheBox</a
				>
				<span class="hero-sep">#</span>
				<a
					href="https://tryhackme.com/p/nofunny"
					target="_blank"
					rel="noopener"
					class="hero-link">TryHackMe</a
				>
			</div>
		</section>

		<hr class="section-divider" />

		{
			recentWriteups.length > 0 && (
				<section class="section">
					<div class="section-header">
						<h2 class="section-title">Recent Writeups</h2>
						<span class="section-count">{allWriteups.length} total</span>
					</div>
					<div class="card-grid">
						{recentWriteups.map((entry) => (
							<a href={`/writeups/${entry.id}`} class="card">
								<div class="card-top">
									<span class="card-title">{entry.data.title}</span>
									<div class="card-badges">
										{entry.data.os && (
											<span class="badge badge--os">{entry.data.os}</span>
										)}
										{entry.data.difficulty && (
											<span
												class="badge"
												style={`color: ${difficultyColors[entry.data.difficulty] ?? "inherit"}; border-color: ${difficultyColors[entry.data.difficulty] ?? "var(--color-border)"}`}
											>
												{entry.data.difficulty}
											</span>
										)}
									</div>
								</div>
								{entry.data.description && (
									<p class="card-desc">{entry.data.description}</p>
								)}
								<div class="card-bottom">
									<div class="card-tags">
										{entry.data.tags.slice(0, 3).map((tag) => (
											<span class="card-tag">#{tag}</span>
										))}
									</div>
									{entry.data.date && (
										<span class="card-date">
											{new Date(entry.data.date).toLocaleDateString("en-US", {
												month: "short",
												day: "numeric",
												year: "numeric",
											})}
										</span>
									)}
								</div>
							</a>
						))}
					</div>
				</section>
			)
		}

		{
			recentNotes.length > 0 && (
				<>
					<hr class="section-divider" />
					<section class="section">
						<div class="section-header">
							<h2 class="section-title">Recent Notes</h2>
							<span class="section-count">{allNotes.length} total</span>
						</div>
						<div class="notes-list">
							{recentNotes.map((entry) => (
								<a href={`/notes/${entry.id}`} class="note-item">
									<span class="note-title">{entry.data.title}</span>
									<div class="note-tags">
										{entry.data.tags.slice(0, 4).map((tag) => (
											<span class="card-tag">#{tag}</span>
										))}
									</div>
								</a>
							))}
						</div>
					</section>
				</>
			)
		}
	</div>
</BaseLayout>

<style>
	.home {
		max-width: var(--content-max-width);
	}

	.hero {
		padding: 1.5rem 0 2rem;
	}

	.hero-title {
		font-size: 2.5rem;
		font-weight: 800;
		font-family: var(--font-mono);
		letter-spacing: -0.03em;
		margin-bottom: 0.5rem;
	}

	.bracket {
		color: var(--color-accent);
	}

	.hero-sub {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		margin-bottom: 1.25rem;
	}

	.hero-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.hero-link {
		font-size: var(--font-size-sm);
		color: var(--color-accent);
		text-decoration: none;
		font-family: var(--font-mono);
	}

	.hero-link:hover {
		text-decoration: underline;
	}

	.hero-sep {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
	}

	.section-divider {
		border: none;
		border-top: 1px solid var(--color-border);
		margin: 2rem 0;
	}

	.section {
		margin-bottom: 0.5rem;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.section-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
	}

	.section-count {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
		cursor: pointer;
	}

	.card:hover {
		border-color: var(--color-accent);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
		text-decoration: none;
	}

	.card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.card-title {
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-text);
		line-height: 1.3;
	}

	.card-badges {
		display: flex;
		gap: 0.35rem;
		flex-shrink: 0;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.badge {
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-family: var(--font-mono);
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
	}

	.card-desc {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		line-height: 1.5;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.5rem;
		border-top: 1px solid var(--color-border);
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.card-tag {
		font-size: var(--font-size-xs);
		font-family: var(--font-mono);
		color: var(--color-accent);
	}

	.card-date {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted);
		white-space: nowrap;
		flex-shrink: 0;
	}

	.notes-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.note-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: border-color var(--transition-fast);
	}

	.note-item:hover {
		border-color: var(--color-accent);
		text-decoration: none;
	}

	.note-title {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
	}

	.note-tags {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	@media (max-width: 640px) {
		.card-grid {
			grid-template-columns: 1fr;
		}

		.note-item {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
