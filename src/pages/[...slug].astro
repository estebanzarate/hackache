---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import PostLayout from "../layouts/PostLayout.astro";
import Callout from "../components/Callout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"posts"> };

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, tags, date, group, parent } = entry.data;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const rawBody: string = (entry as any).body ?? "";
const wordCount = rawBody.trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// OG image
let ogImage: string | undefined;
if (entry.data.image) {
  try {
    const processed = await getImage({
      src: entry.data.image,
      width: 1200,
      height: 630,
      format: "jpeg",
    });
    ogImage = new URL(processed.src, Astro.site).toString();
  } catch {
    ogImage = undefined;
  }
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

// Build full ancestor chain (closest parent last → unshift to get root first)
const ancestors: CollectionEntry<"posts">[] = [];
let parentId = entry.data.parent;
while (parentId) {
  const p = allPosts.find((x) => x.id === parentId);
  if (!p) break;
  ancestors.unshift(p);
  parentId = p.data.parent;
}

const breadcrumb: BreadcrumbItem[] = [];

// Add group from the topmost ancestor (or current entry if standalone)
const topmost = ancestors.length > 0 ? ancestors[0] : entry;
if (topmost.data.group) {
  breadcrumb.push({ label: topmost.data.group });
}

// Add each ancestor as a clickable link
for (const a of ancestors) {
  breadcrumb.push({ label: a.data.title, href: `/${a.id}` });
}

// Prev / Next
interface NavLink {
  title: string;
  href: string;
}

const sorted = (list: CollectionEntry<"posts">[]) =>
  [...list].sort((a, b) => a.data.order - b.data.order);

let siblings: CollectionEntry<"posts">[] = [];

if (parent) {
  siblings = sorted(allPosts.filter((p) => p.data.parent === parent));
} else if (group) {
  siblings = sorted(
    allPosts.filter((p) => !p.data.parent && p.data.group === group),
  );
} else {
  siblings = sorted(allPosts.filter((p) => !p.data.parent && !p.data.group));
}

let prev: NavLink | null = null;
let next: NavLink | null = null;

const idx = siblings.findIndex((p) => p.id === entry.id);
if (idx > 0)
  prev = {
    title: siblings[idx - 1].data.title,
    href: `/${siblings[idx - 1].id}`,
  };
if (idx < siblings.length - 1)
  next = {
    title: siblings[idx + 1].data.title,
    href: `/${siblings[idx + 1].id}`,
  };
---

<PostLayout
  {title}
  {description}
  {tags}
  {date}
  {headings}
  {breadcrumb}
  {prev}
  {next}
  {readingTime}
  body={rawBody}
  {ogImage}
>
  <Content components={{ Callout }} />
</PostLayout>
